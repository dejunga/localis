# Kontakt forma – SMTP preko Zoho Maila
# Kopirati u .env.local za lokalni razvoj, i postaviti u Vercel Project Settings za produkciju.

# Primarna Zoho adresa (ne alias – aliasi se ne mogu autentificirati)
ZOHO_SMTP_USER=info@localis.hr

# App-specific password iz Zoho: accounts.zoho.eu > Security > App Passwords
ZOHO_SMTP_PASSWORD=

# Opcionalno – kamo stižu poruke s forme. Ako je prazno, koristi se ZOHO_SMTP_USER.
CONTACT_TO=info@localis.hr

# Baza (Neon preko Vercel Marketplace) - `vercel env pull .env.local` ih dovlači automatski.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Vercel Blob (privatni store localis-ponude) - PDF-ovi ponuda
BLOB_READ_WRITE_TOKEN=

# Admin panel /admin - jedna zajednička lozinka + tajna za potpis cookieja (random, 32+ znakova)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# 1 = mailovi se samo logiraju u konzolu (lokalni razvoj/testovi)
EMAIL_DRY_RUN=

# Tajna za Vercel cron (/api/cron/upitnici) - random, 32+ znakova
CRON_SECRET=
